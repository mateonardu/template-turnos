# Conexión a MySQL (crear la base template_esteticas primero)
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/template_esteticas"

# Puerto del backend
PORT=3001

# Credenciales de MercadoPago (panel de developers → credenciales)
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."

# URL pública del backend para el webhook de MP
# (en desarrollo: túnel de ngrok/cloudflared; en producción: la URL real)
PUBLIC_URL=""

